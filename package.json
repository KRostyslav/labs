{
  "name": "semiconductor-virtual-lab",
  "description": "Віртуальна лабораторія з фізики напівпровідників для студентів технічних коледжів",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "astro": "astro",
    "export:word": "npm run build && python3 scripts/export-word/export_word.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "$katex"
  }
}
