---
/**
 * Мініатюрний символ лабораторної для карток і шапки (за номером роботи).
 * Для нової лаби додайте свій варіант у switch або буде показано загальний символ.
 */
interface Props {
  number: number;
  size?: number;
}
const { number, size = 56 } = Astro.props;
---

<svg class="glyph" width={size} height={size} viewBox="0 0 56 56" aria-hidden="true">
  <rect width="56" height="56" rx="12" fill="var(--ink)"></rect>
  {
    number === 1 && (
      <g stroke="#f4f0e6" stroke-width="2.4" stroke-linecap="round" fill="none">
        <path d="M8 28h12M36 28h12" />
        <path d="M20 18l16 10-16 10z" fill="var(--accent)" stroke="none" />
        <path d="M36 18v20" />
      </g>
    )
  }
  {
    number === 2 && (
      <g stroke="#f4f0e6" stroke-width="2.2" stroke-linecap="round" fill="none">
        <rect x="9" y="23" width="38" height="10" rx="2" fill="var(--accent)" stroke="none" />
        <path d="M9 28H5M47 28h4M21 23v-9M35 23v-9M21 14h14" />
        <circle cx="28" cy="14" r="0.1" />
      </g>
    )
  }
  {
    number === 3 && (
      <g stroke="#f4f0e6" stroke-width="2.2" stroke-linecap="round" fill="none">
        <path d="M10 44V12M10 44h36" />
        <path d="M13 16c8 2 12 10 16 18s8 8 14 8" stroke="var(--accent)" stroke-width="2.8" />
      </g>
    )
  }
  {
    number === 4 && (
      <g stroke="#f4f0e6" stroke-width="2.2" stroke-linecap="round" fill="none">
        <rect x="12" y="20" width="32" height="16" rx="2" />
        <path d="M4 28h8M44 28h8M28 12v8M28 36v8" />
        <circle cx="28" cy="28" r="4" fill="var(--accent)" stroke="none" />
        <circle cx="28" cy="28" r="1.3" fill="var(--ink)" stroke="none" />
      </g>
    )
  }
  {
    number === 5 && (
      <g stroke="#f4f0e6" stroke-width="2.2" stroke-linecap="round" fill="none">
        <path d="M8 36h12M36 36h12" />
        <path d="M20 27l14 9-14 9z" fill="var(--accent)" stroke="none" />
        <path d="M34 27v18" />
        <path d="M12 8l9 10M20 6l9 10" stroke="#ffd166" />
        <path d="M21 18l-4-1 1-4M29 16l-4-1 1-4" stroke="#ffd166" />
      </g>
    )
  }
  {
    (number < 1 || number > 5) && (
      <g fill="none" stroke="#f4f0e6" stroke-width="2.2">
        <circle cx="28" cy="28" r="12" />
        <circle cx="28" cy="28" r="4" fill="var(--accent)" stroke="none" />
      </g>
    )
  }
</svg>

<style>
  .glyph {
    flex: none;
    display: block;
  }
</style>
