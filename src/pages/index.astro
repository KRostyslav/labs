---
/**
 * Головна сторінка: вступ, перелік лабораторних робіт (з колекції labs), як працювати.
 * Нова лаба з'являється тут автоматично, щойно з'явиться src/labs/NN-назва/index.mdx.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LabGlyph from '@/components/layout/LabGlyph.astro';

const labs = (await getCollection('labs', (e) => !e.data.draft)).sort(
  (a, b) => a.data.number - b.data.number,
);
const first = labs[0];

// --- Декоративна ВАХ діодів для заставки (рівняння Шоклі, без опору бази) ---
const UT = 0.0259;
const X = (u: number) => 40 + ((u + 0.4) / 1.4) * 420; // U: −0,4…1,0 В → 40…460 px
const Y = (i_mA: number) => 300 - (i_mA / 40) * 260; // I: 0…40 мА → 300…40 px
function ivPath(Is: number, n: number): string {
  const pts: string[] = [];
  for (let u = -0.4; u <= 1.0; u += 0.005) {
    const i = Is * (Math.exp(u / (n * UT)) - 1) * 1e3;
    if (i > 40) break;
    pts.push(`${X(u).toFixed(1)},${Y(Math.max(i, -0.6)).toFixed(1)}`);
  }
  return 'M' + pts.join(' L');
}
const gePath = ivPath(1e-6, 1.3);
const siPath = ivPath(5e-9, 1.8);
const steps = [
  { t: 'Прочитайте теорію', d: 'Ключові визначення, формули і пояснення — коротко й по суті.' },
  { t: 'Зніміть виміри', d: 'Змінюйте параметри на віртуальному стенді, читайте покази приладів і записуйте їх у таблицю.' },
  { t: 'Обробіть результати', d: 'Побудуйте графік, обчисліть шукану величину і похибку, як у справжній лабораторній.' },
  { t: 'Виконайте завдання', d: 'Кінцеве завдання і контрольні запитання перевірять, чи все зрозуміло.' },
];
---

<BaseLayout title="Віртуальна лабораторія «Фізика напівпровідників»">
  <section class="hero container">
    <div class="hero__text">
      <p class="kicker">Фізика напівпровідників · віртуальний практикум</p>
      <h1>Лабораторія, яка&nbsp;завжди відчинена</h1>
      <p class="lead">
        Лабораторні роботи з інтерактивними стендами: стрілкові та цифрові прилади, власні
        виміри, графіки на міліметрівці й повноцінна обробка результатів. Для студентів технічних
        коледжів.
      </p>
      <div class="hero__cta">
        {first && <a class="btn btn-primary" href={`/labs/${first.id}/`}>Почати з роботи №{first.data.number}</a>}
        <a class="btn" href="/dovidnyk/">Загальний довідник</a>
      </div>
    </div>

    <figure class="hero__art" aria-label="Вольт-амперні характеристики германієвого та кремнієвого діодів">
      <svg viewBox="0 0 480 340">
        <defs>
          <pattern id="mm" width="10" height="10" patternUnits="userSpaceOnUse">
            <path d="M10 0H0V10" fill="none" stroke="var(--mm-minor)"></path>
          </pattern>
          <pattern id="mm5" width="50" height="50" patternUnits="userSpaceOnUse">
            <rect width="50" height="50" fill="url(#mm)"></rect>
            <path d="M50 0H0V50" fill="none" stroke="var(--mm-mid)"></path>
          </pattern>
        </defs>
        <rect x="0" y="0" width="480" height="340" rx="14" fill="#fffdf6"></rect>
        <rect x="10" y="10" width="460" height="320" rx="8" fill="url(#mm5)"></rect>
        <path d={`M${X(-0.4)} ${Y(0)} H${X(1.0)}`} stroke="var(--ink)" stroke-width="1.6"></path>
        <path d={`M${X(0)} ${Y(-2)} V${Y(40)}`} stroke="var(--ink)" stroke-width="1.6"></path>
        <text x={X(1.0) - 4} y={Y(0) + 18} text-anchor="end" class="ax">U, В</text>
        <text x={X(0) + 8} y={Y(40) + 12} class="ax">I, мА</text>
        {[0.2, 0.4, 0.6, 0.8].map((u) => (
          <text x={X(u)} y={Y(0) + 18} text-anchor="middle" class="tk">{String(u).replace('.', ',')}</text>
        ))}
        <path d={gePath} class="curve curve--ge" pathLength="1"></path>
        <path d={siPath} class="curve curve--si" pathLength="1"></path>
        <text x={X(0.22)} y={Y(30)} class="lbl lbl--ge">Ge</text>
        <text x={X(0.76) + 10} y={Y(30)} class="lbl lbl--si">Si</text>
      </svg>
      <div class="chip" aria-hidden="true">
        <span>0,683 В</span>
        <span>12,4 мА</span>
      </div>
    </figure>
  </section>

  <section class="container labs" id="labs">
    <div class="section-head">
      <h2>Лабораторні роботи</h2>
      <p>Кожна робота — окрема сторінка з теорією, стендом, завданням і власним довідником.</p>
    </div>
    <ol class="cards">
      {
        labs.map((lab, i) => (
          <li style={`--i:${i}`}>
            <a class="card" href={`/labs/${lab.id}/`}>
              <div class="card__top">
                <span class="card__num">{String(lab.data.number).padStart(2, '0')}</span>
                <LabGlyph number={lab.data.number} size={52} />
              </div>
              <h3>{lab.data.shortTitle}</h3>
              <p>{lab.data.summary}</p>
              <div class="card__foot">
                <span>≈ {lab.data.durationMin} хв</span>
                <span class="card__go">Відкрити →</span>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container how">
    <div class="section-head">
      <h2>Як працювати з віртуальною лабораторією</h2>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="steps__n">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))
      }
    </ol>
    <div class="teacher">
      <h3>Викладачу</h3>
      <ul>
        <li>
          Прилади мають реальні межі вимірювання, клас точності й невеликий розкид показів — студенти
          рахують похибки так само, як на справжньому стенді.
        </li>
        <li>
          Записані виміри зберігаються лише в браузері студента (кнопка «Копіювати» переносить таблицю
          в Excel чи Google Таблиці).
        </li>
        <li>Кінцеве завдання зараз однакове для всіх — зразок «X» з фіксованими параметрами.</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding-block: 56px 40px;
  }
  .kicker {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin: 0 0 12px;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.08;
  }
  .lead {
    font-size: 1.12rem;
    color: var(--ink-2);
    max-width: 52ch;
    margin: 18px 0 26px;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero__cta .btn {
    font-size: 1rem;
    padding: 0.75em 1.3em;
  }
  .hero__text > * {
    animation: rise 0.6s ease-out both;
  }
  .hero__text > :nth-child(2) {
    animation-delay: 0.08s;
  }
  .hero__text > :nth-child(3) {
    animation-delay: 0.16s;
  }
  .hero__text > :nth-child(4) {
    animation-delay: 0.24s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .hero__art {
    position: relative;
    margin: 0;
    border: 2px solid var(--ink);
    border-radius: 16px;
    box-shadow: 8px 8px 0 var(--ink);
    transform: rotate(1.2deg);
    background: #fffdf6;
  }
  .hero__art svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .ax {
    font: 700 13px var(--font-body);
    fill: var(--ink);
  }
  .tk {
    font: 500 11px var(--font-mono);
    fill: var(--ink-3);
  }
  .curve {
    fill: none;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.8s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }
  .curve--ge {
    stroke: var(--blue);
    animation-delay: 0.3s;
  }
  .curve--si {
    stroke: var(--accent);
    animation-delay: 0.7s;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .lbl {
    font: 700 18px var(--font-display);
    opacity: 0;
    animation: fade 0.4s ease-out 1.9s forwards;
  }
  .lbl--ge {
    fill: var(--blue);
  }
  .lbl--si {
    fill: var(--accent);
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  .chip {
    position: absolute;
    left: -22px;
    bottom: 26px;
    display: grid;
    gap: 2px;
    padding: 8px 12px;
    background: linear-gradient(180deg, var(--lcd), var(--lcd-2));
    color: var(--lcd-ink);
    font: 700 1rem/1.15 var(--font-mono);
    border-radius: 8px;
    box-shadow:
      0 0 0 3px var(--bakelite),
      0 10px 20px -8px rgba(0, 0, 0, 0.5);
    transform: rotate(-3deg);
    animation: rise 0.5s ease-out 2.1s both;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin: 40px 0 20px;
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head p {
    margin: 0;
    color: var(--ink-3);
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 18px;
  }
  .cards li {
    animation: rise 0.5s ease-out both;
    animation-delay: calc(0.3s + var(--i) * 0.07s);
  }
  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px 16px;
    background: var(--card);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    text-decoration: none;
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .card:hover {
    color: var(--ink);
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--accent);
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .card__num {
    font: 700 2.6rem/1 var(--font-display);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
  }
  .card:hover .card__num {
    color: var(--accent);
    -webkit-text-stroke-color: var(--accent);
  }
  .card h3 {
    margin: 6px 0 0;
    font-size: 1.12rem;
  }
  .card p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
    flex: 1;
  }
  .card__foot {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line-strong);
    font-size: 0.85rem;
    color: var(--ink-3);
  }
  .card__go {
    font-weight: 700;
    color: var(--blue);
  }

  /* Кроки з'єднані «провідником» з вузлами — як на схемі */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    position: relative;
  }
  .steps::before {
    content: '';
    position: absolute;
    left: 20px;
    right: 20px;
    top: 19px;
    border-top: 2px solid var(--blue-2);
  }
  .steps li {
    position: relative;
  }
  .steps__n {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--blue-2);
    font: 700 1rem/1 var(--font-display);
    color: var(--blue-2);
  }
  .steps h3 {
    margin: 12px 0 4px;
  }
  .steps p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .teacher {
    margin-top: 36px;
    padding: 18px 22px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .teacher h3 {
    margin: 0 0 6px;
  }
  .teacher ul {
    margin: 0;
    padding-left: 1.2em;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 32px;
    }
    .hero__art {
      transform: none;
      max-width: 520px;
    }
    .chip {
      left: 8px;
    }
    .steps {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .steps::before {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
