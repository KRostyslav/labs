{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // Аліас: import { mean } from '@/core/stats' замість '../../../core/stats'
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
